{
  "apiVersion": 1,
  "activationScope": "global",
  "id": "pal.usage",
  "name": "Usage",
  "version": "0.2.2",
  "description": "Track provider-reported token usage and activity locally.",
  "author": "Modera",
  "category": "productivity",
  "icon": "chart-no-axes-column-increasing",
  "main": "dist/index.cjs",
  "extensions": ["pal.ui.settings"],
  "settings": {
    "group": "statistics",
    "title": "Usage statistics",
    "frontend": "usage",
    "waitForReady": true,
    "locales": {
      "zh-CN": {
        "title": "用量统计"
      }
    }
  },
  "frontends": {
    "usage": {
      "root": "dist/ui",
      "entry": "index.html"
    }
  },
  "locales": {
    "zh-CN": {
      "name": "用量统计",
      "description": "在本地统计服务端返回的 Token 用量和活跃趋势。"
    }
  },
  "contributions": ["runCompleted"],
  "requiresHost": {
    "pal.commands.callable": 1,
    "pal.commands.dispatch": 1,
    "pal.context.commands": 1,
    "pal.plugin.declarations": 1,
    "pal.settings.commands": 1
  },
  "declarations": {
    "provides": {
      "commands": [
        {
          "id": "pal.usage.snapshot",
          "title": "读取用量统计",
          "visibility": "private",
          "readOnly": true,
          "requiredPermissions": ["pal.storage.read"],
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          }
        }
      ]
    }
  },
  "permissions": ["pal.storage.write", "pal.runs.observe"]
}
