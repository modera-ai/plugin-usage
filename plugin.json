{
  "apiVersion": 1,
  "activationScope": "global",
  "id": "modera.usage",
  "name": "Usage",
  "version": "0.2.0",
  "description": "Track provider-reported token usage and activity locally.",
  "author": "Modera",
  "category": "productivity",
  "icon": "chart-no-axes-column-increasing",
  "main": "dist/index.cjs",
  "permissions": ["storage.read", "storage.write", "runs.observe"],
  "extensions": ["settings"],
  "settings": {
    "title": "Usage statistics",
    "frontend": "usage",
    "waitForReady": true,
    "locales": { "zh-CN": { "title": "用量统计" } }
  },
  "frontends": {
    "usage": { "root": "dist/ui", "entry": "index.html" }
  },
  "locales": {
    "zh-CN": {
      "name": "用量统计",
      "description": "在本地统计服务端返回的 Token 用量和活跃趋势。"
    }
  }
}
