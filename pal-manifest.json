{
  "title": "Usage",
  "activationScope": "global",
  "author": "Modera",
  "category": "productivity",
  "icon": "chart-no-axes-column-increasing",
  "extensions": [
    "pal.ui.settings"
  ],
  "settings": {
    "title": "Usage statistics",
    "frontend": "usage",
    "waitForReady": true,
    "locales": {
      "zh-CN": {
        "title": "用量统计"
      }
    }
  },
  "frontends": {
    "usage": {
      "root": "dist/ui",
      "entry": "index.html"
    }
  },
  "locales": {
    "zh-CN": {
      "name": "用量统计",
      "description": "在本地统计服务端返回的 Token 用量和活跃趋势。"
    }
  },
  "contributions": [
    "runCompleted"
  ],
  "requiresHost": {
    "pal.command.callable": 1,
    "pal.command.dispatch": 1,
    "pal.context.command": 1,
    "pal.plugin.declarations": 1,
    "pal.command.settings": 1
  },
  "declarations": {
    "provides": {
      "commands": [
        {
          "id": "pal.usage.snapshot",
          "title": "读取用量统计",
          "visibility": "private",
          "readOnly": true,
          "requiredPermissions": [
            "pal.storage.read"
          ],
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          }
        }
      ]
    },
    "consumes": {
      "commands": [
        {
          "id": "pal.frontend.context",
          "reason": "使用已声明前端的宿主能力"
        },
        {
          "id": "pal.frontend.settings",
          "reason": "使用已声明前端的宿主能力"
        }
      ]
    }
  },
  "permissions": [
    "pal.storage.write",
    "pal.runs.observe"
  ]
}
